dictionary using CDBRFS03.ASC{
_column(1)     int   fips               %2f    "fips state code"
_column(16)    int   month              %2f    "month of interview"
_column(18)    int   day                %2f    "day of interview"
_column(20)    int   year               %4f    "year of interview"
