dictionary using cdbrfs2002asc.ASC{
_column(1)     int   fips               %2f    "fips state code"
_column(17)    int   month              %2f    "month of interview"
_column(19)    int   day                %2f    "day of interview"
_column(21)    int   year               %4f    "year of interview"
_column(68)    int   adults		%2f    "# adults in household"
_column(72)    int   srhealth           %1f    "self reported health, 1=excellent to 5=poor"
_column(79)    int   exercise           %1f    "exercise in past month, 1=yes, 2=no, 7=DK, 9=refuse"
_column(73)    int   insurance          %1f    "have health insurance, 1=yes, 2=no"
_column(256)    int   checkup	        %1f    "last routine checkup, 1=within past year, 2=past two years, 3=past five years, 4=more than 5, 7=don't know, 8=never, 9=refused"
_column(231)   int   phys_poor          %2f    "# days per month poor physical health"
_column(233)   int   mental_poor        %2f    "# days per month poor mental health"
_column(121)   int   age                %2f    "age in years"
_column(131)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(132)   int   kids               %2f    "# of kids in household"
_column(134)   int   educ               %1f    "education recode"
_column(135)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(136)   int   income94           %2f    "family income, post 1994 coding"
_column(138)   int   weight             %3f    "weight in pounds"
_column(141)   int   height             %3f    "height in inches"
_column(144)   int   county             %3f    "county of residence"
_column(149)   int   sex                %1f    "sex, 1=male, 2=female"
_column(878)   int   smoke_status       %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(917)   int   race5              %1f    "race/ethnicity 1=w(NH), 2=b(NH), 3=o(nh) 4=mixed(NH) 5=Hispanic"
_column(869)   int   fruit_veggie       %1f    "fruit & vegetable index, 1=once a day or never, 2=one to three times a day, 3=three to five times a day, 4=five or more times, 9=DK"
_column(893)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(889)   int   totaldrinks        %4f    "total number of drinks per month"
_column(822)   double  finalwgt         %10f   "final weight"
}
