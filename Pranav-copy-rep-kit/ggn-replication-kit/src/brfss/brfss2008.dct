dictionary using CDBRFS08.ASC{
_column(1)     int   fips               %2f    "fips state code"
_column(16)    int   month              %2f    "month of interview"
_column(18)    int   day                %2f    "day of interview"
_column(20)    int   year               %4f    "year of interview"
_column(60)    int   adults		%2f    "# adults in household"
_column(73)    int   srhealth           %1f    "self reported health, 1=excellent to 5=poor"
_column(86)    int   exercise           %1f    "exercise in past month, 1=yes, 2=no, 7=DK, 9=refuse"
_column(74)    int   phys_poor          %2f    "# days per month poor physical health"
_column(76)    int   mental_poor        %2f    "# days per month poor mental health"
_column(101)   int   age                %2f    "age in years"
_column(112)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(113)   int   kids               %2f    "# of kids in household"
_column(115)   int   educ               %1f    "education recode"
_column(116)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(117)   int   income94           %2f    "family income, post 1994 coding"
_column(119)   int   weight             %4f    "weight in pounds"
_column(123)   int   height             %4f    "height in inches"
_column(132)   int   county             %3f    "county of residence"
_column(143)   int   sex                %1f    "sex, 1=male, 2=female"
_column(1220)  int   smoke_status       %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(1240)  int   race5              %1f    "race/ethnicity 1=w(NH), 2=b(NH), 3=o(nh) 4=mixed(NH) 5=Hispanic"
_column(1280)  int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(1276)  int   totaldrinks        %4f    "total number of drinks per month"
_column(312)   int   active_duty        %1f    "military duty, 1=yes, 2=national guard or reserves"
_column(80)    int   insurance          %1f    "have health insurance, 1=yes, 2=no"
_column(81)	   int   persdoc		    %1f    "person has personal doctor, 1=only one, 2=more than one, 3=no, 7=Dk, 9=refused"
_column(82)    int	 affordcare		    %1f    "in the last year could you not afford a doctor, 1=yes, 2=no, 7=don't know, 9=refused"	
_column(83)    int   checkup	        %1f    "last routine checkup, 1=within past year, 2=past two years, 3=past five years, 4=more than 5, 7=don't know, 8=never, 9=refused"
_column(799)   double  finalwgt         %10f   "final weight"
_column(206)   int   satisfied          %1f    "satisfied with your life, 1=very satisfied, 2=satisfied, 3=dissatisfied, 4=very satisfied"
}
