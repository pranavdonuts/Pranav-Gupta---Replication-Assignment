dictionary using cdbrfss1994asc.ASC{
_column(1)     int   fips               %2f    "fips state code"
_column(10)    int   month              %2f    "month of interview"
_column(12)    int   day                %2f    "day of interview"
_column(14)    int   year               %2f    "year of interview"
_column(29)    int   adults		%2f    "# adults in household"
_column(33)    int   srhealth           %1f    "self reported health, 1=excellent to 5=poor"
_column(45)    int   exercise           %1f    "exercise in past month, 1=yes, 2=no, 7=DK, 9=refuse"
_column(34)    int   phys_poor          %2f    "# days per month poor physical health"
_column(36)    int   mental_poor        %2f    "# days per month poor mental health"
_column(40)    int   insurance		    %1f    "have any kind of health care plan, 1=yes, 2=no, 7=don't know, 9=refused"	
_column(41)	   int	 insgap		        %1f    "how long since you last had coverage, 1=1-6 mos, 2=7-12 months, 3=1-2 years, 4=2-5 years, 5=5 or more years, 7=don't know, 8=never, 9=refused"
_column(42)    int	 affordcare		    %1f    "in the last year could you not afford a doctor, 1=yes, 2=no, 7=don't know, 9=refused"
_column(43)    int   checkup	        %1f    "last routine checkup, 1=within past year, 2=past two years, 3=past five years, 4=more than 5, 7=don't know, 8=never, 9=refused"
_column(466)   int   phys_act           %1f    "activity level, 1=sedentary, 2=irregular, 3=regular, 4=vigorous, 9=DK"
_column(103)   int   age                %2f    "age in years"
_column(107)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(108)   int   kids_under_5       %1f    "# of kids in household under 5"
_column(109)   int   kids5_12           %1f    "kids between 5 and 12"
_column(110)   int   kids13_17          %1f    "kids between 13 and 17"
_column(111)   int   educ               %1f    "education recode , 1=never, 2=grade 1-8, 3=some hs, 4=hsgrad, 5=some coll or tech, 6=coll grad, 9=refused"
_column(112)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(113)   int   income94           %2f    "family income, post 1994 coding"
_column(115)   int   weight             %3f    "weight in pounds"
_column(121)   int   height             %3f    "height in inches"
_column(124)   int   county             %3f    "county of residence"
_column(129)   int   sex                %1f    "sex, 1=male, 2=female"
_column(453)   int   smoke94            %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(535)   int   race4              %1f    "race/ethnicity 1=w(NH), 2=b(NH), 3=Hispanic 4=other(NH) 5=DK"
_column(480)   int   fruit_veggie       %1f    "fruit & vegetable index, 1=once a day or never, 2=one to three times a day, 3=three to five times a day, 4=five or more times, 9=DK"
_column(487)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(454)   int   totaldrinks        %4f    "total number of drinks per month"
_column(515)   double  finalwgt         %10f   "final weight"
}

