_column(66)    int   srhealth           %1f    "self reported health, 1=excellent to 5=poor"
_column(89)    int   exercise           %1f    "exercise in past month, 1=yes, 2=no, 7=DK, 9=refuse"
_column(67)    int   phys_poor          %2f    "# days per month poor physical health, 88=none"
_column(69)    int   mental_poor        %2f    "# days per month poor mental health, 88=none"
_column(73)    int   insurance		    %1f    "have any kind of health care plan, 1=yes, 2=no, 7=don't know, 9=refused"
_column(80)	   int	 insgap		        %1f    "how long since you last had coverage, 1=1-6 mos, 2=7-12 months, 3=1-2 years, 4=2-5 years, 5=5 or more years, 7=don't know, 8=never, 9=refused"
_column(81)    int	 affordcare		    %1f    "in the last year could you not afford a doctor, 1=yes, 2=no, 7=don't know, 9=refused"	
_column(82)    int   checkup	        %1f    "last routine checkup, 1=within past year, 2=past two years, 3=past five years, 4=more than 5, 7=don't know, 8=never, 9=refused"
_column(867)   int   phys_act           %1f    "activity level, 1=sedentary, 2=irregular, 3=regular, 4=vigorous, 9=DK"
_column(145)   int   age                %2f    "age in years"
_column(149)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(150)   int   kids_under_5       %1f    "# of kids in household under 5, 8=none"
_column(151)   int   kids5_12           %1f    "kids between 5 and 12, 8=none"
_column(152)   int   kids13_17          %1f    "kids between 13 and 17, 8=none"
_column(153)   int   educ               %1f    "education recode"
_column(154)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(155)   int   income94           %2f    "family income, post 1994 coding"
_column(160)   int   weight             %3f    "weight in pounds"
_column(166)   int   height             %3f    "height in inches"
_column(169)   int   county             %3f    "county of residence"
_column(174)   int   sex                %1f    "sex, 1=male, 2=female"
_column(857)   int   smoke_status       %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(891)   int   race4              %1f    "race/ethnicity 1=w(NH), 2=b(NH), 3=Hispanic 4=other(NH) 5=DK"
_column(876)   int   fruit_veggie       %1f    "fruit & vegetable index, 1=once a day or never, 2=one to three times a day, 3=three to five times a day, 4=five or more times, 9=DK"
_column(881)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(858)   int   totaldrinks        %4f    "total number of drinks per month"
_column(832)   double  finalwgt         %10f   "final weight"
}
