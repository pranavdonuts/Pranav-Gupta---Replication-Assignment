_column(351)   int   race8              %2f    "race/ethnicity 01=w(NH), 02=b(NH), 03=white hispanic, 04=black hispanic, 05=other hispanic, 06=asian, 07=indian, 08=other,99=DK"
_column(394)   int   fruit_veggie       %1f    "fruit & vegetable index, 1=once a day or never, 2=one to three times a day, 3=three to five times a day, 4=five or more times, 9=DK"
_column(372)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
