dictionary using cdbrfss1991asc.ASC{
_column(1)     int   fips               %2f    "fips state code"
_column(10)    int   month              %2f    "month of interview"
_column(12)    int   day                %2f    "day of interview"
_column(14)    int   year               %2f    "year of interview"
_column(29)    int   adults				%2f    "# adults in household"
_column(83)    int   checkup	        %1f    "last routine checkup, 1=within past year, 2=past two years, 3=past five years, 4=more than 5, 7=don't know, 8=never, 9=refused"
_column(92)    int   insurance		    %1f    "have any kind of health care plan, 1=yes, 2=no, 7=don't know, 9=refused"
_column(93)    int	 hospins			%1f    "health insurance covers hospital visits, 1=all, 2=most, 3=some, 4=none, 7=don't know, 9=refused"
_column(94)    int   docins				%1f    "health insurance covers doctor visits, 1=all, 2=most, 3=some, 4=none, 7=don't know, 9=refused"
_column(95)    int	 preventins			%1f    "health insurance covers preventitive, 1=all, 2=most, 3=some, 4=none, 7=don't know, 9=refused"
_column(96)    int	 affordcare		    %1f    "in the last year could you not afford a doctor, 1=yes, 2=no, 7=don't know, 9=refused"
_column(97)    int   age                %2f    "age in years"
_column(103)   int   marital            %1f    "marital status 1=marr 2=widow 3=div 4=sep 5=nev mar 6=couple 9=DK"
_column(101)   int   educ               %1f    "education recode, 1= eigth grade or less, 2=some HS, 3=HS grad or GED, 4=some tech, 5=tech grad, 6=some coll, 7=coll grad, 8=post grad, 9=refused"
_column(102)   int   employ             %1f    "employment, 1=wages, 2=self-employ, 3=jobless<1 yr, 4=jobless>1 yr, 5=homemaker, 6=student, 7=retired, 8=unable, 9=DK"
_column(104)   int   income93           %1f    "family income, 1993 coding"
_column(105)   int   weight             %3f    "weight in pounds"
_column(108)   int   height             %3f    "height in inches"
_column(144)   int   county             %3f    "county of residence"
_column(111)   int   sex                %1f    "sex, 1=male, 2=female"
_column(403)   int   smoke93            %1f    "smoking status, 1=all, 2=some, 3=former, 4=never, 9=DK"
_column(401)   int   race8              %2f    "race/ethnicity 01=w(NH), 02=b(NH), 03=white hispanic, 04=black hispanic, 05=other hispanic, 06=asian, 07=indian, 08=other,99=DK"
_column(430)   int   fruit_veggie       %1f    "fruit & vegetable index, 1=once a day or never, 2=one to three times a day, 3=three to five times a day, 4=five or more times, 9=DK"
_column(438)   int   alcoholic          %1f    "chronic drinking, 1=not at risk, 2=at risk, 9=DK"
_column(404)   int   totaldrinks        %4f    "total number of drinks per month"
_column(416)   int   phys_act           %1f    "activity level, 1=sedentary, 2=irregular, 3=regular, 4=vigorous, 9=DK"
_column(465)   double  finalwgt         %10f   "final weight"
}



