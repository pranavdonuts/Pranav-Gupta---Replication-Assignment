> (blue) msymbol(o) ) ///
>         , ///
>         ylabel(, nogrid angle(horizontal) axis(1)  ) ///
>         ylabel(, nogrid angle(horizontal) axis(2)  ) ///
>         scheme(s2mono)  ///
>         xline(`tenncare_line') ///
>         aspectratio(`inv_golden_ratio') ///
>         graphregion(fcolor(white))  ///
>         legend(off) ///
>         yscale( nofextend ) xscale(nofextend) ///
>         xtitle(" ") ///
>         xlabel(2004(1)2007) ///
>         ytitle("", axis(1)) ytitle("", axis(2)) ///
