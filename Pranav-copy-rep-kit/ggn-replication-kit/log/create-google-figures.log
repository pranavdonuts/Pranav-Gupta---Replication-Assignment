. /* --------------------------------------
> 
> This program creates figures based on the google
> search data.
> 
> --------------------------------------- */
. 
. clear all

. estimates clear

. set mem 500m
set memory ignored.
    Memory no longer needs to be set in modern Statas; memory adjustments are
    performed on the fly automatically.

. 
. 
. 
. ************************************************************
. **   Program used below
. ************************************************************
. 
. capture program drop convert_week_to_date

. program define convert_week_to_date
  1.         tab week
  2.         gen startyear = real( regexs(1) ) if regexm(week, "([0-9]+)-([0-9]+
> )-([0-9]+) - ([0-9]+)-([0-9]+)-([0-9]+)")
  3.         gen startmonth = real( regexs(2) ) if regexm(week, "([0-9]+)-([0-9]
> +)-([0-9]+) - ([0-9]+)-([0-9]+)-([0-9]+)")
  4.         gen startday = real( regexs(3) ) if regexm(week, "([0-9]+)-([0-9]+)
> -([0-9]+) - ([0-9]+)-([0-9]+)-([0-9]+)")
  5.         gen endyear = real( regexs(4) ) if regexm(week, "([0-9]+)-([0-9]+)-
> ([0-9]+) - ([0-9]+)-([0-9]+)-([0-9]+)")
  6.         gen endmonth = real( regexs(5) ) if regexm(week, "([0-9]+)-([0-9]+)
> -([0-9]+) - ([0-9]+)-([0-9]+)-([0-9]+)")
  7.         gen endday = real( regexs(6) ) if regexm(week, "([0-9]+)-([0-9]+)-(
> [0-9]+) - ([0-9]+)-([0-9]+)-([0-9]+)")
  8. 
.         gen startdate = mdy(startmonth , startday, startyear)
  9.         format startdate %td
 10.         gen enddate = mdy(endmonth , endday, endyear)
 11.         format enddate %td
 12.         list week startdate enddate
 13.         drop startyear startmonth startday endyear endmonth endday
 14. end

. 
. capture program drop destring_ifstring

. program define destring_ifstring
  1.     local type: type `1'
  2.     if substr("`type'",1,3) == "str" { 
  3.             rename `1' `1'_orig
  4.             gen `1' = real(`1'_orig)
  5.             drop `1'_orig
  6.             disp "`1' destringed"
  7.     }
  8.     if substr("`type'",1,3) == "str" {
  9.             disp "`1' not a string"
 10.     }
 11. end

. 
